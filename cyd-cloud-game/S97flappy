#!/bin/sh
# /etc/init.d/S97flappy: run the Flappy cloud-game server for the CYD at boot (port 8766).
# Install:  cp /root/S97flappy /etc/init.d/ && chmod +x /etc/init.d/S97flappy
PIDFILE=/var/run/flappy_server.pid

start() {
    printf "Starting flappy_server: "
    start-stop-daemon -S -b -m -p "$PIDFILE" -x /root/flappy_server -- 8766 /root/flappy_best
    echo "OK"
}

stop() {
    printf "Stopping flappy_server: "
    start-stop-daemon -K -q -p "$PIDFILE"
    rm -f "$PIDFILE"
    echo "OK"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
