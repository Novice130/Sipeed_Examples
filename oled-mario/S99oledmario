#!/bin/sh
# /etc/init.d/S99oledmario: start the OLED Mario demo at boot (oled-on.sh sets power pin + I2C3 pinmux).
# Install:  cp /root/S99oledmario /etc/init.d/ && chmod +x /etc/init.d/S99oledmario
PIDFILE=/var/run/oled_mario.pid

start() {
    printf "Starting oled_mario: "
    /root/oled-on.sh
    sleep 1
    start-stop-daemon -S -b -m -p "$PIDFILE" -x /root/oled_mario -- mario
    echo "OK"
}

stop() {
    printf "Stopping oled_mario: "
    start-stop-daemon -K -q -p "$PIDFILE"
    rm -f "$PIDFILE"
    sleep 1
    /root/oled_mario clear >/dev/null 2>&1
    echo "OK"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
